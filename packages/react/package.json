{
  "name": "@puzzlekit/react",
  "version": "0.1.0",
  "description": "React bindings for PuzzleKit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "peerDependencies": {
    "@puzzlekit/core": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react --external @puzzlekit/core"
  }
}